{
  "id": "amd-low-vram",
  "label": "Low VRAM (~8 GB)",
  "target_vram_gb": 8,
  "memory": {
    "placement": "sequential_cpu_offload",
    "dtype": "bfloat16",
    "attention_slicing": true,
    "vae_slicing": true,
    "vae_tiling": true,
    "text_encoder_on_cpu": true,
    "blurb": "Layer-by-layer RAM↔VRAM — safest for 6–8 GB cards."
  },
  "agent": {
    "provider": "ollama",
    "base_url": "http://127.0.0.1:11434",
    "model": "llama3.2:3b",
    "max_tokens": 1200
  },
  "generation": {
    "backend": "builtin",
    "max_concurrent_jobs": 1,
    "default_width": 768,
    "default_height": 448,
    "default_frames": 49,
    "fps": 16,
    "default_t2v": "wan21-t2v-1.3b",
    "default_t2i": "sdxl-turbo",
    "default_i2v": "ltx-video-0.9.7",
    "default_ref2i": "sdxl-turbo",
    "default_ref2v": "ltx-video-0.9.7",
    "cpu_offload": true,
    "attention_slicing": true,
    "sequential": true
  },
  "notes": "Built-in engine (no ComfyUI). Short clips, one job at a time."
}
