{
  "id": "vram-4gb",
  "label": "Ultra-low VRAM (~4 GB)",
  "target_vram_gb": 4,
  "memory": {
    "placement": "sequential_cpu_offload",
    "dtype": "float16",
    "attention_slicing": true,
    "vae_slicing": true,
    "vae_tiling": true,
    "text_encoder_on_cpu": true,
    "blurb": "Lowest VRAM: layers stream from system RAM onto the GPU one at a time."
  },
  "agent": {
    "provider": "ollama",
    "base_url": "http://127.0.0.1:11434",
    "model": "llama3.2:3b",
    "max_tokens": 800
  },
  "generation": {
    "backend": "builtin",
    "max_concurrent_jobs": 1,
    "default_width": 512,
    "default_height": 512,
    "default_frames": 25,
    "fps": 12,
    "default_t2v": "wan21-t2v-1.3b",
    "default_t2i": "sd15",
    "default_i2v": "ltx-video-0.9.7",
    "default_ref2i": "sd15",
    "default_ref2v": "ltx-video-0.9.7",
    "cpu_offload": true,
    "attention_slicing": true,
    "sequential": true
  },
  "notes": "For 4–6 GB cards. Prefer small models; expect slow generation."
}
