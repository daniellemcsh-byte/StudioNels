{
  "id": "amd-r9700",
  "label": "R9700 — light GPU",
  "target_vram_gb": 12,
  "memory": {
    "placement": "model_cpu_offload",
    "dtype": "float16",
    "attention_slicing": false,
    "vae_slicing": true,
    "vae_tiling": false,
    "text_encoder_on_cpu": true,
    "blurb": "Video core on the GPU in float16. The big text encoder stays in RAM."
  },
  "agent": {
    "provider": "ollama",
    "base_url": "http://127.0.0.1:11434",
    "model": "llama3.1:8b",
    "max_tokens": 2500
  },
  "generation": {
    "backend": "builtin",
    "max_concurrent_jobs": 1,
    "default_width": 768,
    "default_height": 432,
    "default_frames": 33,
    "fps": 16,
    "default_t2v": "wan21-t2v-1.3b",
    "default_t2i": "flux-schnell",
    "default_i2v": "wan22-ti2v-5b",
    "default_t2a": "stable-audio-open",
    "default_ref2i": "flux-schnell",
    "default_ref2v": "cogvideox-i2v-5b",
    "cpu_offload": true,
    "attention_slicing": false,
    "sequential": true
  },
  "notes": "R9700: float16, text encoder in RAM, Wan 1.3B at 768×432 for tests. LTX-2.3 is still in the model list when you want a heavier clip."
}
