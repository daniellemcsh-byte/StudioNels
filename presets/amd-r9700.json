{
  "id": "amd-r9700",
  "label": "R9700 — Wan2GP profile 1",
  "target_vram_gb": 32,
  "memory": {
    "placement": "gpu",
    "dtype": "float16",
    "attention_slicing": false,
    "vae_slicing": true,
    "vae_tiling": false,
    "text_encoder_on_cpu": false,
    "blurb": "Wan2GP profile 1: float16, SDPA, preload what fits on the 32 GB card."
  },
  "agent": {
    "provider": "ollama",
    "base_url": "http://127.0.0.1:11434",
    "model": "llama3.1:8b",
    "max_tokens": 2500
  },
  "generation": {
    "backend": "builtin",
    "max_concurrent_jobs": 1,
    "default_width": 768,
    "default_height": 432,
    "default_frames": 33,
    "fps": 16,
    "default_t2v": "wan21-t2v-1.3b",
    "default_t2i": "flux-schnell",
    "default_i2v": "wan22-ti2v-5b",
    "default_t2a": "stable-audio-open",
    "default_ref2i": "flux-schnell",
    "default_ref2v": "cogvideox-i2v-5b",
    "cpu_offload": false,
    "attention_slicing": false,
    "sequential": false
  },
  "notes": "Same setup Wan2GP uses on this card: profile 1, float16, SDPA. The first clip loads the model. The next one reuses it."
}
