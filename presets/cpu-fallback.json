{
  "id": "cpu-fallback",
  "label": "CPU / system RAM only",
  "target_vram_gb": 0,
  "memory": {
    "placement": "cpu",
    "dtype": "float32",
    "attention_slicing": true,
    "vae_slicing": true,
    "vae_tiling": true,
    "text_encoder_on_cpu": true,
    "blurb": "Everything in system RAM — preview / no usable GPU."
  },
  "agent": {
    "provider": "builtin",
    "base_url": null,
    "model": "builtin-planner",
    "max_tokens": 800
  },
  "generation": {
    "backend": "builtin",
    "max_concurrent_jobs": 1,
    "default_width": 640,
    "default_height": 352,
    "default_frames": 16,
    "fps": 12,
    "default_t2v": "wan21-t2v-1.3b",
    "default_t2i": "sdxl-turbo",
    "default_i2v": "ltx-video-0.9.7",
    "default_ref2i": "sdxl-turbo",
    "default_ref2v": "ltx-video-0.9.7",
    "cpu_offload": true,
    "attention_slicing": true,
    "sequential": true
  },
  "notes": "UI + preview frames only until ROCm PyTorch is installed."
}
